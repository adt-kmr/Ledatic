# Backend environment variables. Copy to .env (git-ignored) and fill in real values.
# Never commit secrets.

# Razorpay (payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Groq (LLM investigator)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (fallback LLM)
ANTHROPIC_API_KEY=

# Auth
JWT_SECRET=
IMEI_HMAC_SECRET=

# Database / cache
DATABASE_URL=postgresql+asyncpg://citadel:citadel_dev@postgres:5432/citadel
REDIS_URL=redis://localhost:6379

# VirusTotal
VIRUSTOTAL_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
