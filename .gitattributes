# Scripts that get executed via a shebang inside Linux containers must keep
# LF line endings regardless of the checkout platform's core.autocrlf — a
# CRLF shebang line ("#!/usr/bin/env bash\r") fails with "bash\r: No such
# file or directory" once the file reaches a container (e.g. via a Docker
# Compose bind-mount, which re-copies the host's line endings at runtime
# even though the image's build step already stripped them).

*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
