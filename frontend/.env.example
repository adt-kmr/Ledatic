# Frontend environment variables (build-time, Vite).
# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.

# Razorpay public key (test mode). Safe to expose to the browser.
VITE_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxxxx

# Google OAuth client id (public).
VITE_GOOGLE_CLIENT_ID=

# Twilio credentials used by the demo UI (server-side preferred).
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_FROM_NUMBER=
VITE_TWILIO_TO_NUMBER=
